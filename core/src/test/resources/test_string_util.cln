package main;

import std.console.writeLine;
import std.str.intToStr;
import std.str.strLen;
import std.str.strCat;
import std.str.toUpper;
import std.str.toLower;
import std.str.trim;

(var int ret = 0) testIntToStr() {
    var String result = intToStr(42);
    writeLine(result);
    return;
}

(var int ret = 0) testStrLen() {
    var int result = strLen("Hello");
    var String lenStr = intToStr(result);
    writeLine(lenStr);
    return;
}

(var int ret = 0) testStrCat() {
    var String result = strCat("Hello, ", "World!");
    writeLine(result);
    return;
}

(var int ret = 0) testToUpper() {
    var String result = toUpper("hello");
    writeLine(result);
    return;
}

(var int ret = 0) testToLower() {
    var String result = toLower("WORLD");
    writeLine(result);
    return;
}

(var int ret = 0) testTrim() {
    var String result = trim("  spaces  ");
    writeLine(result);
    return;
}

(var int ret = 0) main() {
    testIntToStr();
    testStrLen();
    testStrCat();
    testToUpper();
    testToLower();
    testTrim();
    return;
}
