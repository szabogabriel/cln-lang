package main;

import std.console.writeLine;

// Old style: named return variables
(var int result = 0) oldStyleAdd(int a, int b) {
    result = a + b;
    return;
}

// New style: simple return type
int newStyleAdd(int a, int b) {
    return a + b;
}

// New style with explicit return
int calculate(int x) {
    if (x > 10) {
        return x * 2;
    }
    return x + 5;
}

// No return type (void)
printMessage() {
    writeLine("Both syntaxes work!");
    return;
}

int main() {
    var int oldSum = oldStyleAdd(10, 20);
    var int newSum = newStyleAdd(15, 25);
    var int calc = calculate(8);
    
    writeLine("Old style sum: " + oldSum);
    writeLine("New style sum: " + newSum);
    writeLine("Calculated: " + calc);
    
    printMessage();
    
    return 0;
}
