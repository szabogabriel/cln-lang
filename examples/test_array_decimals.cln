import std.console.*;
import std.str.*;

// Test decimal arrays and arithmetic operations
int main() {
    var dec[] prices = [19.99, 25.50, 12.75, 8.25, 15.00];
    
    writeLine("Decimal array operations:");
    
    // Test 1: Print all prices
    var int i = 0;
    while (i < prices.length) {
        writeLine("prices[" + intToStr(i) + "] = " + prices[i]);
        i++;
    }
    
    // Test 2: Calculate total
    var dec total = 0.0;
    i = 0;
    while (i < prices.length) {
        total = total + prices[i];
        i++;
    }
    writeLine("Total: " + total);
    
    // Test 3: Calculate average
    var dec average = total / prices.length;
    writeLine("Average: " + average);
    
    // Test 4: Apply discount (10%)
    var dec discount_rate = 0.10;
    i = 0;
    while (i < prices.length) {
        prices[i] = prices[i] * (1.0 - discount_rate);
        i++;
    }
    
    writeLine("After 10% discount:");
    i = 0;
    while (i < prices.length) {
        writeLine("prices[" + intToStr(i) + "] = " + prices[i]);
        i++;
    }
    
    // Test 5: Find most expensive
    var dec maxPrice = prices[0];
    i = 1;
    while (i < prices.length) {
        if (prices[i] > maxPrice) {
            maxPrice = prices[i];
        }
        i++;
    }
    writeLine("Most expensive (after discount): " + maxPrice);
    
    writeLine("Decimal array tests passed!");
    
    return 0;
}
