import std.console.*;
import std.str.*;

// Test array with functions
(var int sum = 0) sumArray(int[] arr) {
    var int i = 0;
    var int len = arr.length;
    while (i < len) {
        var int elem = arr[i];
        sum = sum + elem;
        i = i + 1;
    }
    return;
}

(var int min = 0) findMin(int[] arr) {
    if (arr.length == 0) {
        return;
    }
    
    min = arr[0];
    var int i = 1;
    while (i < arr.length) {
        if (arr[i] < min) {
            min = arr[i];
        }
        i++;
    }
    return;
}

int[] createRange(int start, int count) {
    var int[] result = [];
    // Note: We can't actually populate it properly without dynamic array resize
    // This is a limitation for now
    return result;
}

printArray(int[] arr) {
    var int i = 0;
    while (i < arr.length) {
        writeLine("  [" + intToStr(i) + "] = " + intToStr(arr[i]));
        i++;
    }
    return;
}

int main() {
    var int[] numbers = [15, 8, 23, 4, 42, 16];
    
    writeLine("Array contents:");
    printArray(numbers);
    
    int total = sumArray(numbers);
    writeLine("Sum: " + intToStr(total));
    
    int minimum = findMin(numbers);
    writeLine("Minimum: " + intToStr(minimum));
    
    writeLine("Array function tests passed!");
    
    return 0;
}
