import std.console.*;
import std.str.*;

// Test array operations in loops
int main() {
    // Test 1: Iterate and print array elements
    var int[] numbers = [10, 20, 30, 40, 50];
    
    writeLine("Array elements:");
    var int i = 0;
    while (i < numbers.length) {
        writeLine("numbers[" + intToStr(i) + "] = " + intToStr(numbers[i]));
        i++;
    }
    
    // Test 2: Calculate sum
    var int sum = 0;
    i = 0;
    while (i < numbers.length) {
        sum = sum + numbers[i];
        i++;
    }
    writeLine("Sum of array elements: " + intToStr(sum));
    
    // Test 3: Find maximum
    var int max = numbers[0];
    i = 1;
    while (i < numbers.length) {
        if (numbers[i] > max) {
            max = numbers[i];
        }
        i++;
    }
    writeLine("Maximum element: " + intToStr(max));
    
    // Test 4: Reverse array
    var int[] reversed = [0, 0, 0, 0, 0];
    i = 0;
    while (i < numbers.length) {
        reversed[i] = numbers[numbers.length - 1 - i];
        i++;
    }
    
    writeLine("Reversed array:");
    i = 0;
    while (i < reversed.length) {
        writeLine("reversed[" + intToStr(i) + "] = " + intToStr(reversed[i]));
        i++;
    }
    
    writeLine("All loop tests passed!");
    
    return 0;
}
