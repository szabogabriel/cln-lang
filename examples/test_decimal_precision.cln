package main;

import std.console.*;

int main() {
    // Test 1: Basic decimal without precision
    dec pi = 3.14159265;
    writeLine("Original pi: " + pi);
    
    // Test 2: Decimal with precision (should round to 2 decimal places)
    dec(2) pi2 = pi;
    writeLine("pi2 (2 decimals): " + pi2);  // Expected: 3.14
    
    // Test 3: Decimal with precision and HALF_UP rounding mode
    dec(2, HALF_UP) pi3 = pi;
    writeLine("pi3 (2 decimals, HALF_UP): " + pi3);  // Expected: 3.14
    
    // Test 4: Assignment should maintain precision
    dec value = 9.87654321;
    writeLine("Original value: " + value);
    
    dec(3) rounded = value;
    writeLine("Rounded to 3 decimals: " + rounded);  // Expected: 9.877
    
    // Test 5: Variable assignment should maintain constraints
    var dec(2) price = 19.999;
    writeLine("Price (2 decimals): " + price);  // Expected: 20.00
    
    price = 15.556;
    writeLine("Updated price: " + price);  // Expected: 15.56
    
    // Test 6: Different rounding modes
    dec testVal = 2.125;
    dec(2, HALF_UP) roundedUp = testVal;
    dec(2, HALF_DOWN) roundedDown = testVal;
    dec(2, CEILING) roundedCeil = testVal;
    dec(2, FLOOR) roundedFloor = testVal;
    
    writeLine("testVal: " + testVal);
    writeLine("HALF_UP: " + roundedUp);      // Expected: 2.13
    writeLine("HALF_DOWN: " + roundedDown);  // Expected: 2.12
    writeLine("CEILING: " + roundedCeil);    // Expected: 2.13
    writeLine("FLOOR: " + roundedFloor);     // Expected: 2.12
    
    // Test 7: Arithmetic operations
    dec(2) a = 10.556;
    dec(2) b = 5.444;
    dec(2) sum = a + b;
    writeLine("Sum: " + sum);  // Expected: 16.00 (10.56 + 5.44 = 16.00)
    
    return 0;
}
