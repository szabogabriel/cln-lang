package main;

import std.console.*;
import std.str.*;

var int globalVar = 123;
string globalString = "This is global string";

updateGlobalVar() {
    globalVar = 234;
}

int main() {
    writeLine("Global variable: " + intToStr(globalVar));
    writeLine("Global string: " + globalString);

    updateGlobalVar();

    writeLine("Global variable: " + intToStr(globalVar));

    return 0;
}
