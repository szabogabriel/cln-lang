//package main;

import std.console.*;
import std.str.*;

int main() {
    var int x = 5;
    
    // Test prefix increment
    writeLine("x = " + intToStr(x));
    writeLine("++x = " + intToStr(++x));
    writeLine("x = " + intToStr(x));
    
    // Test postfix increment
    writeLine("x++ = " + intToStr(x++));
    writeLine("x = " + intToStr(x));
    
    // Test prefix decrement
    writeLine("--x = " + intToStr(--x));
    writeLine("x = " + intToStr(x));
    
    // Test postfix decrement
    writeLine("x-- = " + intToStr(x--));
    writeLine("x = " + intToStr(x));
    
    // Test in expression
    var int y = 10 + x++;
    writeLine("y = 10 + x++ -> " + intToStr(y));
    writeLine("x = " + intToStr(x));
    
    // Test multiple increments
    var int z = ++x + ++x;
    writeLine("z = ++x + ++x -> " + intToStr(z));
    writeLine("x = " + intToStr(x));
    
    return 0;
}
