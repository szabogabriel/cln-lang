package test;

import std.console.writeLine;
import std.str.*;

struct Circle {
    int radius;
};

updateCircle(Circle c) {
    c.radius = 10;
    return;
}

int main() {
    var Circle c = Circle(radius: 5);
    writeLine("The radius is: " + intToStr(c.radius));    

    updateCircle(c);
    writeLine("The changed radius: " + intToStr(c.radius));
    return 0;
}
